*--------------------------------------------------------------------------------------
* gm_amy.def : ポート A は GM、ポート B は AMY
* 出力先の機器は MIDI ポートの設定で選ぶ。このファイルは PART ASSIGN の初期値だけを分ける。
* A1-A9, A11-A16 は part 7 (GM)。A10 は part 8 (GM Drums)。
* B1-B9, B11-B16 は part 9 (AMY)。B10 は part 10 (AMY Drums)。
* バンク番号はパートに属する。トラックに書いた CC#0 を、そのままそのポートへ送る。
* 音色名は 14 文字で切れる。
* Juno 名の先頭にあった A11/B88 は本体のバンク・グループ・番号。
* STed2 のリスト左の 1-128 と重複するので省略し、音色名を 14 文字まで使う。
*--------------------------------------------------------------------------------------

* 使用する音源の機種名(表示用=module/内部処理用=id)
#module= MODULE: GM+AMY

#id=GM+AMY

* 演奏時のラストパラメータ送信のウエイト
#lsp_wait=1	* (0～16= wait×0～16 / -1=パラメータを送信しない)

*======================================================================================
* レコーディングの設定

* メトロノームで使用するノート(click&bell)
*        ch prg  key gt vel  key gt vel
#rec_met=10,  0,  37, 2,106,  56, 2,120

* RHYTHM ASSIGN は 32 枠が一つ。キットでは切り替わらない。
*        ch prog bank ,, vel   bank は CC#0。0 は GM キット。
#rhy_as=10,0,0,,127
*--------------------------------------------------------------------------------------
Hand Clap     , 39, 1,Mute Hi Conga , 62, 1,Open Hi Conga , 63, 1,Low Conga     , 64, 1
Crash Cymbal 1, 49, 1,Ride Cymbal 1 , 51, 1,Pedal Hi-Hat  , 44, 1,Open Hi-Hat   , 46, 1
Closed Hi-Hat , 42, 1,Hi-Mid Tom    , 48, 1,Low Tom       , 45, 1,Low Floor Tom , 41, 1
Side Stick    , 37, 1,Electric Snare, 40, 1,Acoustic Snare, 38, 1,Bass Drum 1   , 36, 1
AcousBassDrum , 35, 1,Low-Mid Tom   , 47, 1,High Tom      , 50, 1,Splash Cymbal , 55, 1
Ride Bell     , 53, 1,Cowbell       , 56, 1,Tambourine    , 54, 1,Hi Bongo      , 60, 1
High Timbale  , 65, 1,Low Timbale   , 66, 1,Cabasa        , 69, 1,Maracas       , 70, 1
Claves        , 75, 1,Short Whistle , 71, 1,Mute Triangle , 80, 1,Open Triangle , 81, 1
* 入れなかったノート: 43,52,57,59,61,67,68,72,76,77 は多くのキットで同じサンプル。
* 58,73,74,78,79 はどのキットにも音が無い。
*--------------------------------------------------------------------------------------
#defoff

*======================================================================================
* チャンネルごとの音色リスト

#group_a=7,7,7,7,7,7,7,7,7,8,7,7,7,7,7,7	* (ch.A1-16) GM
#group_b=9,9,9,9,9,9,9,9,9,10,9,9,9,9,9,9	* (ch.B1-16) AMY

#gs_mode=2	* bit 0 = キャピタル落ち 0:off 1:on
		* bit 1 = rhythm         0:off 1:on
		* bit 2 = bank mode      0:bank msb 1:bank lsb

* part 7 の CC#0=0。GM のピアノ。part 9 の 0 とは別の行。
#gs_pbank	* バンク 0 → part 16
16
#defoff

* part 9 に #bank が無い番号では、フラットな名前を出さない。
#gm_mode=2

* #bank= CC#0, CC#32, 名前表のパート, この行を出すパート
* 4番目は 7 / 9 / 11 / 13。省くと全メロディパートに出て、ピアノと Juno が混ざる。
#bank=0,0,20,9	* Juno。パッチ 0-127
#bank=1,0,17,9	* DX7。パッチ 128-255
* バンク 2 は載せていない。パッチ 256-258。安定したら戻す。
#bank=3,0,19,9	* キット名。メロディチャンネルで選ぶとき

* #rbank= CC#0, CC#32, プログラム, 鍵盤名のパート, リズムパート
* 5番目は 8 / 10 / 12 / 14。同じ CC#0 を二つのリズムパートには書けない。
#rbank=0,0,0,38,8	* GM Standard
#rbank=3,0,0,26,10	* pcm_tiny（ホストが 384→258）

#part=7, GM           , GM:
