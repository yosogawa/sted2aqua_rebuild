*--------------------------------------------------------------------------------------
* amy.def : AMY の音色表
* メロディの CC#0 は 0=Juno、1=DX7、3=ドラムキット名。
* 2（パッチ 256-258）は実験的な実装なので載せていない。トラックにあってもプログラム 0-2 は送らない。
* CC#32 は使わない。バリエーションは 0 だけ。
* ドラムキットの鍵盤名は ch.10（part 8）。キットはプログラム 0-6、CC#0=3。
* 鍵盤名は各キットのサンプル名。GM の楽器名とは限らない。
* 空欄は、そのノートにサンプルが無い。ノート番号は空欄でも進む。
* 音色名は 14 文字で切れる。
*--------------------------------------------------------------------------------------

* 使用する音源の機種名(表示用=module/内部処理用=id)
#module= MODULE: AMY Synthesizer

#id=AMY

#lsp_wait=1

*        ch prg  key gt vel  key gt vel
#rec_met=10,  0,  37, 2,106,  56, 2,120

* RHYTHM ASSIGN は 32 枠が一つ。キットでは切り替わらない。
* ノート番号は全キット共用。名前は GM の役割名。
*        ch prog bank ,, vel   bank は CC#0。prog 0 は TR-808。
#rhy_as=10,0,3,,127
*--------------------------------------------------------------------------------------
Hand Clap     , 39, 1,Mute Hi Conga , 62, 1,Open Hi Conga , 63, 1,Low Conga     , 64, 1
Crash Cymbal 1, 49, 1,Ride Cymbal 1 , 51, 1,Pedal Hi-Hat  , 44, 1,Open Hi-Hat   , 46, 1
Closed Hi-Hat , 42, 1,Hi-Mid Tom    , 48, 1,Low Tom       , 45, 1,Low Floor Tom , 41, 1
Side Stick    , 37, 1,Electric Snare, 40, 1,Acoustic Snare, 38, 1,Bass Drum 1   , 36, 1
AcousBassDrum , 35, 1,Low-Mid Tom   , 47, 1,High Tom      , 50, 1,Splash Cymbal , 55, 1
Ride Bell     , 53, 1,Cowbell       , 56, 1,Tambourine    , 54, 1,Hi Bongo      , 60, 1
High Timbale  , 65, 1,Low Timbale   , 66, 1,Cabasa        , 69, 1,Maracas       , 70, 1
Claves        , 75, 1,Short Whistle , 71, 1,Mute Triangle , 80, 1,Open Triangle , 81, 1
* 入れなかったノート: 43,52,57,59,61,67,68,72,76,77 は多くのキットで同じサンプル。
* 58,73,74,78,79 はどのキットにも音が無い。
*--------------------------------------------------------------------------------------
#defoff

* ch.10 だけリズム。ほかはメロディ。
#group_a=7,7,7,7,7,7,7,7,7,8,7,7,7,7,7,7	* (ch.A1-16)
#group_b=7,7,7,7,7,7,7,7,7,8,7,7,7,7,7,7	* (ch.B1-16)

* #bank= CC#0, CC#32, 名前表のパート
* #rbank= CC#0, CC#32, プログラム, 鍵盤名のパート
#bank=0,0,16
#bank=1,0,17
* バンク 2 は載せていない。パッチ 256-258。安定したら戻す。
#bank=3,0,19

#rbank=3,0,0,26	* TR-808
#rbank=3,0,1,27	* TR-909
#rbank=3,0,2,28	* Linn 9000
#rbank=3,0,3,29	* MR-12
#rbank=3,0,4,30	* Tokyo Synthetics
#rbank=3,0,5,31	* Power
#rbank=3,0,6,32	* Percussion

#part=8, AMY Drums     , AMY:
*--------------------------------------------------------------------------------------
TR-808,TR-909,Linn 9000,MR-12
TKO Synthetics,Power,Percussion
*--------------------------------------------------------------------------------------
#defoff

