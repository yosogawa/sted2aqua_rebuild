*--------------------------------------------------------------------------------------
* gm.def : General MIDI Level 1, drum kits as shipped on GM1 instruments
*         Melodic bank 0 is the 128 GM programs, same order as the DLS capital map.
*         Channel 10 selects a kit by program change on bank 0, not GM2's CC#0=120.
*         The nine kits use the same program numbers as gm2.def:
*           0 Standard, 8 Room, 16 Power, 24 Electronic, 25 TR-808,
*           32 Jazz, 40 Brush, 48 Orchestra, 56 SFX.
*         Programs 0 through 48 share the GM rhythm key map (notes 35-81).
*         Program 56 (SFX) has a kit name and no key map.
*--------------------------------------------------------------------------------------

* 使用する音源の機種名(表示用=module/内部処理用=id)
#module= MODULE: GM

#id=GM

* 演奏時のラストパラメータ送信のウエイト
#lsp_wait=1	* (0～16= wait×0～16 / -1=パラメータを送信しない)

*======================================================================================
* レコーディングの設定

* メトロノームで使用するノート(click&bell)
*        ch prg  key gt vel  key gt vel
#rec_met=10,  0,  37, 2,106,  56, 2,120

*======================================================================================
* チャンネルごとの音色リスト
* part 7 がメロディ。バンク 0 だけ GM の 128 音色(part 16)。
* part 8 がリズム。ch.10。9 キットは gm2 と同じプログラム番号。
* プログラム 0,8,16,24,25,32,40,48 の鍵盤名は part 38。56 (SFX) は無し。

#group_a=7,7,7,7,7,7,7,7,7,8,7,7,7,7,7,7	* (ch.A1-16)
#group_b=7,7,7,7,7,7,7,7,7,8,7,7,7,7,7,7	* (ch.B1-16)

#gs_mode=2	* bit 0 = キャピタル落ち 0:off 1:on
		* bit 1 = rhythm         0:off 1:on
		* bit 2 = bank mode      0:bank msb 1:bank lsb

#gs_pbank	* バンク 0 → part 16
16
#defoff

#gs_rbank	* プログラム番号 → 鍵盤名パート。0 は無し
38,0,0,0,0,0,0,0	*  0 Standard
38,0,0,0,0,0,0,0	*  8 Room
38,0,0,0,0,0,0,0	* 16 Power
38,38,0,0,0,0,0,0	* 24 Electronic, 25 TR-808
38,0,0,0,0,0,0,0	* 32 Jazz
38,0,0,0,0,0,0,0	* 40 Brush
38,0,0,0,0,0,0,0	* 48 Orchestra
0,0,0,0,0,0,0,0	* 56 SFX は鍵盤名なし
#defoff

*======================================================================================
* リズムアサインの初期データ(1～32) (リズムネームは14文字まで)

* サウンドテスト用の設定
#rhy_as=10,0,-1,,127	* ch.(1～16),prog.(0～127,-1=off),bank_l(0～127,-1=off),,vel
*--------------------------------------------------------------------------------------
*[RHYTHM NAME][KEY,GT][RHYTHM NAME]-[KEY,GT][RHYTHM NAME]-[KEY,GT][RHYTHM NAME]-[KEY,GT]
Hand Clap     , 39, 1,Mute Hi Conga , 62, 1,Open Hi Conga , 63, 1,Low Conga     , 64, 1
Crash Cymbal 1, 49, 1,Ride Cymbal 1 , 51, 1,Pedal Hi-Hat  , 44, 1,Open Hi-Hat   , 46, 1
Closed Hi-Hat , 42, 1,Hi-Mid Tom    , 48, 1,Low Tom       , 45, 1,Low Floor Tom , 41, 1
Side Stick    , 37, 1,Electric Snare, 40, 1,Acoustic Snare, 38, 1,Bass Drum 1   , 36, 1
High Timbale  , 65, 1,Low Timbale   , 66, 1,Cowbell       , 56, 1,Hi Bongo      , 60, 1
Low Bongo     , 61, 1,High Agogo    , 67, 1,Low Agogo     , 68, 1,Tambourine    , 54, 1
Claves        , 75, 1,Maracas       , 70, 1,Short Whistle , 71, 1,Long Whistle  , 72, 1
Cabasa        , 69, 1,Short Guiro   , 73, 1,              ,  0, 1,              ,  0, 1
*--------------------------------------------------------------------------------------
#defoff

